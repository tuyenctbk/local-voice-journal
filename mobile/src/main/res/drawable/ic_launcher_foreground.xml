<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Glowing Aura Ring -->
    <path
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M 54,20 A 34,34 0 1,1 53.99,20 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7A60FF" />
                <item android:offset="0.5" android:color="#FFC0B3FF" />
                <item android:offset="1.0" android:color="#FF00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Background Aura Glow -->
    <path
        android:pathData="M 54,24 A 30,30 0 1,1 53.99,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:type="radial">
                <item android:offset="0.0" android:color="#607A60FF" />
                <item android:offset="0.6" android:color="#20C0B3FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Audio reflection / sound waves representing local voice journal -->
    <!-- Far Left Wave -->
    <path
        android:pathData="M 38,48 L 38,60"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="48"
                android:endX="38"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7A60FF" />
                <item android:offset="1.0" android:color="#FFC0B3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid Left Wave -->
    <path
        android:pathData="M 46,40 L 46,68"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46"
                android:startY="40"
                android:endX="46"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7A60FF" />
                <item android:offset="1.0" android:color="#FFC0B3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Wave (Journal Core Reflection) -->
    <path
        android:pathData="M 54,32 L 54,76"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="32"
                android:endX="54"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFC0B3FF" />
                <item android:offset="0.5" android:color="#FFFFD700" />
                <item android:offset="1.0" android:color="#FFC0B3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid Right Wave -->
    <path
        android:pathData="M 62,40 L 62,68"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="62"
                android:startY="40"
                android:endX="62"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7A60FF" />
                <item android:offset="1.0" android:color="#FFC0B3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Far Right Wave -->
    <path
        android:pathData="M 70,48 L 70,60"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="70"
                android:startY="48"
                android:endX="70"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7A60FF" />
                <item android:offset="1.0" android:color="#FFC0B3FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
